# Placeholders only. Nothing loads this file automatically: the demo runs without
# any of these set. To change one, export it in your shell before `npm run dev`.

# Server
PORT=4400
# Either DATABASE_URL or the standard PG* variables (PGHOST, PGPORT, PGUSER, PGPASSWORD).
DATABASE_URL=postgres://submission_wizard:submission_wizard@localhost:5432/submission_wizard
# Optional. Overrides the database name (also the one in DATABASE_URL). Default: submission_wizard_development.
SUBMISSION_WIZARD_DATABASE=submission_wizard_development
# Required in production: at least 32 bytes, and not this example. For example: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-value
# Defaults to true when NODE_ENV=production, false otherwise.
SESSION_COOKIE_SECURE=false
# false, true (one proxy) or the number of proxies you control that append to x-forwarded-for.
TRUST_PROXY=false
# Comma-separated origins, with no path or trailing slash.
ALLOWED_ORIGINS=http://localhost:5180
# Relative paths resolve from the folder the server starts in (server/ under npm run dev).
STORAGE_DIR=./storage
PRESS_TIME_ZONE=Europe/Dublin

# Web (Vite dev and preview servers)
SUBMISSION_WIZARD_API_URL=http://localhost:4400
